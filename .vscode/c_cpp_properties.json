{
    "configurations": [
        {
            "name": "FFXIV",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/tools/msvc8.0sp1/include",
                "${workspaceFolder}/tools/msvc8.0sp1/PlatformSDK/include",
                "${workspaceFolder}/include",
                "${workspaceFolder}/third_party/dxsdk"
            ],
            "defines": [
                "UNICODE",
                "_UNICODE",
                "WIN32",
                "NDEBUG",
                "_WINDOWS",
                "_MSC_VER=1400",
                "_MSC_FULL_VER=140050727",
                "_WIN32",
                "_M_IX86=600",
                "_MSC_EXTENSIONS",
                "_INTEGRAL_MAX_BITS=64",
                "_CPPRTTI",
                "_CPPUNWIND",
                "_NATIVE_WCHAR_T_DEFINED",
                "_WCHAR_T_DEFINED"
            ],
            "compilerPath": "",
            "cStandard": "c99",
            "cppStandard": "c++03",
            "intelliSenseMode": "windows-msvc-x86",
            "mergeConfigurations": false,
            "recursiveIncludes": {},
            "browse": {
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}